# Copia a .env y ajusta. Este proyecto es independiente de otros Docker Compose.

MYSQL_ROOT_PASSWORD=greace_root_change_me
MYSQL_DATABASE=sistemagreace
MYSQL_USER=greace
MYSQL_PASSWORD=greace_pass_change_me

# Puertos en el HOST (elige libres para no chocar con tu otro proyecto)
MYSQL_HOST_PORT=3307
WEB_HOST_PORT=5080

FLASK_DEBUG=0
MYSQL_WAIT_SECONDS=60

# ─── WhatsApp (digest accionable) ───
# Por defecto: modo "debo" = bloque Hilos urgentes (ámbar/rojo, no legado)
# + resumen de totales (sin listar backlog Excel antiguo).
# Modos: debo | hilos | plazos | both
WHATSAPP_ENABLED=0
WHATSAPP_PROVIDER=callmebot
WHATSAPP_TO=51970713168
CALLMEBOT_APIKEY=
WHATSAPP_DIGEST_MODE=debo
WHATSAPP_DEBO_TOP=10
WHATSAPP_DEBO_ESP=5
WHATSAPP_INTERVAL_MINUTES=180
WHATSAPP_NOTIFY_ON_START=0
NOTIFY_SECRET=

# ─── Hilos (reloj next-response) ───
# Ancla = última carta abierta con deuda; legado si días(ancla) > HILO_LEGADO_DIAS
HILO_PLAZO_DIAS=5
HILO_VERDE_HASTA=3
HILO_AMARILLO_DIA=4
HILO_LEGADO_DIAS=60
HILO_OPERATIVO_MAX_DIAS=15

AUTH_REQUIRED=1
SECRET_KEY=sistemagreace-dev-change-me-in-prod
DEFAULT_USER_PASSWORD=greace2026
AUTH_INCLUDE_MIXTA=1

FORCE_PASSWORD_ROTATION=1
MIN_PASSWORD_LEN=8

# Producción futura (Meta Cloud API + plantilla utility):
# WHATSAPP_PROVIDER=meta
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=
